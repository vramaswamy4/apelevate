# Copy to .env for local development (`make dev` does this for you).
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind TLS: DJANGO_SECURE=1 turns on HTTPS redirect, secure cookies and HSTS.
DJANGO_SECURE=0

# Defaults to SQLite (db.sqlite3). docker-compose sets a PostgreSQL URL.
# DATABASE_URL=postgres://apelevate:apelevate@localhost:5432/apelevate

# Email: the console backend is the default in development.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Payments: "fake" (development and tests) or "paypal".
PAYMENTS_BACKEND=fake
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox

# Study-plan model. "fake" works offline; "openai" calls any OpenAI-compatible API (default Groq).
LLM_BACKEND=fake
# LLM_API_KEY=         # set by infra/set-llm-key.sh
# LLM_MODEL=openai/gpt-oss-120b
